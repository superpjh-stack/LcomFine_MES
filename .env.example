# 엘컴화인 MES — 환경변수 (접두 LCOMFINE_). 값은 저장소에 적지 않는다. 로컬은 `.env`(gitignore) 에 둔다.
# `make setup` 이 `.env` 가 없으면 난수 비밀을 채워 만든다 (tools/init_env.py).
LCOMFINE_PG_DSN=postgresql:///lcomfine_db
LCOMFINE_ENV=dev
LCOMFINE_PORT=8020
# 세션 서명 비밀 — 비워 두면 기동할 때마다 난수(재기동 시 로그인 풀림)
LCOMFINE_SESSION_SECRET=
# 시드 계정 8(부서 sl·pr·sh·ds·ac·st·ex·admin)의 비밀번호. 없으면 시드·check-routes·pytest 가 명시적으로 실패한다 (G-19)
LCOMFINE_SEED_PASSWORD=
# 퀵 로그인(1 이면 켬). 로그인 화면에 계정 단추가 생기고 누르면 LCOMFINE_SEED_PASSWORD 로 로그인한다 — 개발·테스트 전용.
# LCOMFINE_ENV=prod 에서는 켜도 꺼진다(D-416)
LCOMFINE_QUICK_LOGIN=
# 자동 로그아웃(분). 설계도에 수치 없음 → 비우면 만료시키지 않는다
LCOMFINE_SESSION_IDLE_MINUTES=
# 현황판 자동 새로고침(초). 설계도에 수치 없음 → 기본 30 (가설 D-19)
LCOMFINE_BOARD_REFRESH_SECONDS=
# Docker(docker-compose.yml) 로 올릴 때만 쓴다 — PostgreSQL 컨테이너의 DB 비밀번호. 로컬(unix socket)에서는 쓰지 않는다 (D-03)
LCOMFINE_DB_PASSWORD=
# Docker 의 앱 DB 역할(lcomfine_app — superuser 아님 · 불변 이력 INSERT 만 · D-524) 비밀번호. 소유자 역할(lcomfine)과 다른 값 — `make setup` 이 난수로 채운다
LCOMFINE_APP_DB_PASSWORD=
# 문서관리 SSO(DOC) 주소. 비우면 화면에 `미확정 (D-517)` (G-18)
LCOMFINE_DOC_SSO_URL=
# SSO 토큰 서명 비밀 — `make setup` 이 난수로 채운다
LCOMFINE_SSO_SECRET=
